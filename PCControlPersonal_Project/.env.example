APP_NAME=PC Control Personal Server
APP_VERSION=1.0.0
ENVIRONMENT=production
DEBUG=false

SERVER_HOST=0.0.0.0
SERVER_PORT=8765
BASE_PUBLIC_URL=http://YOUR_SERVER_IP:8765
TRUSTED_ORIGINS=["*"]
LOCAL_ONLY=false

CONFIG_FILE=/etc/pcmanager/config.json
DATA_DIR=/var/lib/pcmanager
LOGS_DIR=/var/log/pcmanager
STORAGE_DIR=/var/lib/pcmanager/storage
DATABASE_URL=sqlite:////var/lib/pcmanager/server.db

ADMIN_TOKEN=change-this-admin-login-token
SERVER_ACCESS_KEY=change-this-api-access-key
JWT_SECRET=change-this-long-random-jwt-secret
JWT_EXPIRE_MINUTES=10080

TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=0
TELEGRAM_ALLOWED_USER_IDS=0
TELEGRAM_BOT_ENABLED=true
START_TELEGRAM_BOT_WITH_SERVER=false

AGENT_BOOTSTRAP_TOKEN=change-this-agent-bootstrap-token
ENABLE_SCREENSHOT=false
ENABLE_CAMERA=false
ENABLE_VIDEO_RECORDING=false
ENABLE_PROCESS_KILL=false
ENABLE_SERVER_SCREENSHOT=false
ENABLE_SERVER_WEBCAM=false
ENABLE_SERVER_WEBCAM_VIDEO=false
MAX_SERVER_WEBCAM_VIDEO_SECONDS=10
ENABLE_AGENT_SCREENSHOT=true
ENABLE_AGENT_CAMERA=false
ENABLE_AGENT_VIDEO_RECORDING=false
ALLOW_DANGEROUS_COMMANDS=false
ALLOWED_SCRIPT_NAMES=cleanup_temp,collect_diagnostics

TASK_TIMEOUT_SECONDS=300
SAFE_RETRY_COUNT=2
MAX_RESULT_BYTES=512000
API_RATE_LIMIT_PER_MINUTE=120
MAX_UPLOAD_MB=200
MAX_VIDEO_SECONDS=30
ALLOWED_UPLOAD_EXTENSIONS=.jpg,.jpeg,.png,.gif,.webp,.mp4,.webm,.mov,.avi,.mkv,.mp3,.wav,.ogg,.m4a,.txt,.log,.csv,.json,.pdf,.doc,.docx,.xls,.xlsx,.ppt,.pptx,.zip,.7z,.rar,.apk,.exe

# Wake-on-LAN: включение твоих ПК из сервера.
# Формат: имя=MAC,имя2=MAC2
WOL_DEVICES=
WOL_BROADCAST_IP=255.255.255.255
WOL_PORT=9
LOCAL_CHECK_NOTIFY_OK=false

TEMP_WARNING_C=85
TEMP_CRITICAL_C=90
LOG_RETENTION_DAYS=14
BACKUP_RETENTION_DAYS=30
BACKUP_KEEP_LAST=5
METRICS_RETENTION_DAYS=30
METRICS_COLLECT_INTERVAL_MIN=5
NETWORK_SCAN_SUBNET=192.168.0.0/24
TELEGRAM_NOTIFY_EVENTS=true
TELEGRAM_NOTIFY_INFO=false
